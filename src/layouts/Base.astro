---
import { pwaInfo } from 'virtual:pwa-info';

export type Tab = 'home' | 'itinerary' | 'landmarks' | 'basics';

interface Props {
  title: string;
  tab: Tab;
  /** 상세 화면이면 상단에 돌아가기 링크를 둔다 */
  back?: { href: string; label: string };
  /** 첫 요소가 화면 끝까지 닿는 사진일 때 본문 위쪽 여백을 없앤다 */
  bleed?: boolean;
}

const { title, tab, back, bleed = false } = Astro.props;
const pageTitle = tab === 'home' ? '교토여행' : `${title} · 교토여행`;

const tabs: { id: Tab; href: string; label: string; icon: string }[] = [
  {
    id: 'home',
    href: '/',
    label: '홈',
    icon: '<path d="M3 10.5 12 4l9 6.5"/><path d="M5.5 9v11h13V9"/><path d="M10 20v-5h4v5"/>',
  },
  {
    id: 'itinerary',
    href: '/itinerary/',
    label: '일정',
    icon: '<rect x="4" y="5" width="16" height="15" rx="1.5"/><path d="M4 10h16M9 3v4M15 3v4M8 14h3M8 17h6"/>',
  },
  {
    id: 'landmarks',
    href: '/landmarks/',
    label: '교토 명소',
    icon: '<path d="M2.5 6.5c3.5 1.3 15.5 1.3 19 0l-.6 2.6c-4.3.9-13.5.9-17.8 0z"/><path d="M5 12h14M7.5 9v12M16.5 9v12"/>',
  },
  {
    id: 'basics',
    href: '/basics/',
    label: '일본 기본',
    icon: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/><path d="M9 8h7M9 11.5h5"/>',
  },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#efede8" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="교토여행" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@600;800&display=swap"
    />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <title>{pageTitle}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
      // 등장 스크립트가 실패해도 내용이 숨겨진 채 남지 않게 한다.
      setTimeout(() => document.querySelectorAll('[data-reveal]').forEach((e) => e.classList.add('in')), 2500);
    </script>
  </head>
  <body class:list={{ bleed }}>
    {
      back && (
        <nav class="back" class:list={{ floating: bleed }}>
          <a href={back.href} aria-label={`${back.label}(으)로 돌아가기`}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" />
            </svg>
            <span>{back.label}</span>
          </a>
        </nav>
      )
    }
    <main>
      <slot />
    </main>
    <nav class="tabbar" aria-label="메인 메뉴">
      {
        tabs.map((t) => (
          <a href={t.href} aria-current={t.id === tab ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} />
            <span>{t.label}</span>
          </a>
        ))
      }
    </nav>
    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });

      // 화면에 들어오는 요소를 차례로 띄운다 (한 번만).
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* 생성(生成り) 바탕, 먹, 도리이 주홍, 이끼 */
    --ground: #efede8;
    --sheet: #e4e1da;
    --sheet-2: #d9d5cc;
    --ink: #1c1a17;
    --ink-soft: #4f4a43;
    --sumi: #1f1d1a;
    --on-sumi: #f1eee8;
    --vermilion: #d23a22;
    --vermilion-deep: #a82c17;
    --moss: #56633a;
    --serif: 'Noto Serif KR', 'Hiragino Mincho ProN', 'Yu Mincho', 'AppleMyungjo', serif;
    --sans:
      -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Noto Sans KR', 'Hiragino Sans',
      'Noto Sans JP', sans-serif;
    --tabbar-h: 72px;
    --gutter: 20px;
    color-scheme: light;

    /* 이전 디자인 이름 → 새 토큰 (리디자인이 끝나면 지운다) */
    --surface: #f7f6f2;
    --line: var(--sheet-2);
    --rule: var(--sheet-2);
    --accent: var(--vermilion);
    --text: var(--ink);
    --muted: var(--ink-soft);
    --paper: var(--ground);
    --indigo: var(--sumi);
  }
  /* 이전 디자인 클래스 (명소 상세, 일본 기본에서 아직 사용) */
  .card {
    background: var(--surface);
    padding: 16px;
  }
  .badge {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--vermilion-deep);
  }
  * {
    box-sizing: border-box;
  }
  html {
    font-size: 18px;
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    color: var(--ink);
    background: var(--ground);
    font-family: var(--sans);
    line-height: 1.6;
    word-break: keep-all;
    overflow-wrap: anywhere;
    -webkit-tap-highlight-color: transparent;
  }
  main {
    max-width: 680px;
    margin: 0 auto;
    padding: 24px var(--gutter) calc(var(--tabbar-h) + 48px + env(safe-area-inset-bottom));
  }
  body.bleed main {
    padding-top: 0;
  }
  h1,
  h2,
  h3,
  .serif {
    font-family: var(--serif);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  h1 {
    font-size: 2.2rem;
    line-height: 1.15;
    margin: 12px 0 8px;
  }
  h2 {
    font-size: 1.45rem;
    line-height: 1.25;
    margin: 56px 0 16px;
  }
  a {
    color: var(--vermilion-deep);
  }
  img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  .muted {
    color: var(--ink-soft);
  }
  .lead {
    color: var(--ink-soft);
    margin: 0 0 16px;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 56px 0 18px;
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head .more {
    margin-left: auto;
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 50px;
    padding: 0 20px;
    border: 0;
    background: var(--sheet-2);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.12s ease, background-color 0.15s ease;
  }
  .btn.primary {
    background: var(--vermilion);
    color: #fff;
  }
  .btn:active {
    transform: scale(0.97);
  }
  :focus-visible {
    outline: 3px solid var(--vermilion);
    outline-offset: 2px;
  }
  /* 인장: 주홍 도장 */
  .seal {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 56px;
    height: 56px;
    background: var(--vermilion);
    color: #fff;
    font-family: var(--serif);
    font-weight: 800;
    line-height: 1;
    text-align: center;
  }
  .seal b {
    font-size: 1.55rem;
  }
  .seal small {
    font-size: 0.7rem;
    margin-top: 3px;
  }
  .tag {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--vermilion-deep);
    white-space: nowrap;
  }
  .back {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--ground);
    padding: env(safe-area-inset-top) 8px 0;
  }
  .back.floating {
    position: fixed;
    inset: 0 auto auto 0;
    background: none;
    padding: calc(10px + env(safe-area-inset-top)) 12px 0;
  }
  .back a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 48px;
    padding: 0 16px 0 10px;
    font-weight: 700;
    text-decoration: none;
    color: var(--ink);
  }
  .back.floating a {
    background: var(--ground);
    border-radius: 999px;
    box-shadow: 0 2px 12px #0003;
  }
  .back svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tabbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 10;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--sumi);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .tabbar a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    height: var(--tabbar-h);
    color: #b9b2a6;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    transition: color 0.15s ease;
  }
  .tabbar svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tabbar a[aria-current='page'] {
    color: #fff;
  }
  .tabbar a[aria-current='page'] svg {
    stroke: #ff6a4d;
  }
  .tabbar a[aria-current='page']::before {
    content: '';
    position: absolute;
    top: 0;
    left: 30%;
    right: 30%;
    height: 4px;
    background: var(--vermilion);
  }
  /* 등장: 스크립트가 없거나 모션을 줄인 환경에서는 그대로 보인다 */
  .js [data-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 70ms);
  }
  .js [data-reveal].in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .js [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
