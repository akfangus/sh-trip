---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { pwaInfo } from 'virtual:pwa-info';

export type Tab = 'home' | 'itinerary' | 'landmarks' | 'basics';

interface Props {
  title: string;
  tab: Tab;
  /** 상세 화면이면 상단에 돌아가기 링크를 둔다 */
  back?: { href: string; label: string };
  /** 첫 요소가 화면 끝까지 닿는 사진일 때 본문 위쪽 여백을 없앤다 */
  bleed?: boolean;
  /** 화면 위쪽에 깔리고 아래로 바탕색에 스며드는 배경 사진 */
  backdrop?: ImageMetadata;
}

const { title, tab, back, bleed = false, backdrop } = Astro.props;
const pageTitle = tab === 'home' ? '교토여행' : `${title} · 교토여행`;
const backdropImage = backdrop ? await getImage({ src: backdrop, width: 800, quality: 60 }) : undefined;

const tabs: { id: Tab; href: string; label: string; icon: string }[] = [
  {
    id: 'home',
    href: '/',
    label: '홈',
    icon: '<path d="M3 10.5 12 4l9 6.5"/><path d="M5.5 9v11h13V9"/><path d="M10 20v-5h4v5"/>',
  },
  {
    id: 'itinerary',
    href: '/itinerary/',
    label: '일정',
    icon: '<rect x="4" y="5" width="16" height="15" rx="1.5"/><path d="M4 10h16M9 3v4M15 3v4M8 14h3M8 17h6"/>',
  },
  {
    id: 'landmarks',
    href: '/landmarks/',
    label: '교토 명소',
    icon: '<path d="M2.5 6.5c3.5 1.3 15.5 1.3 19 0l-.6 2.6c-4.3.9-13.5.9-17.8 0z"/><path d="M5 12h14M7.5 9v12M16.5 9v12"/>',
  },
  {
    id: 'basics',
    href: '/basics/',
    label: '일본 기본',
    icon: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/><path d="M9 8h7M9 11.5h5"/>',
  },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#e6e7e6" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="교토여행" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- 제목: 마루부리 서브셋(앱에 포함, 오프라인 가능). 본문: Pretendard(받을 때 캐시, 없으면 시스템 고딕) -->
    <link rel="preload" href="/fonts/kyoto-trip-serif-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ bleed, 'has-backdrop': backdropImage }}>
    {
      backdropImage && (
        <div class="backdrop" aria-hidden="true" style={`--backdrop: url(${backdropImage.src})`} />
      )
    }
    <div class="eaves" aria-hidden="true"></div>
    {
      back && (
        <nav class="back" class:list={{ floating: bleed }}>
          <a href={back.href} aria-label={`${back.label}(으)로 돌아가기`}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" />
            </svg>
            <span>{back.label}</span>
          </a>
        </nav>
      )
    }
    <main>
      <slot />
    </main>
    <nav class="tabbar" aria-label="메인 메뉴">
      <div class="eaves" aria-hidden="true"></div>
      <div class="tabs">
        {
          tabs.map((t) => (
            <a href={t.href} aria-current={t.id === tab ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} />
              <span>{t.label}</span>
            </a>
          ))
        }
      </div>
    </nav>
    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Kyoto Trip Serif';
    src: url('/fonts/kyoto-trip-serif-bold.woff2') format('woff2');
    font-weight: 700;
    font-display: swap;
  }

  /*
   * 교토의 가을 디자인 토큰 (D2: 기와와 목재 + 단풍 사진 배경)
   * 대비는 바탕 #E6E7E6 기준: 먹 12.2, 보조 6.6, 단풍 5.8, 들보 8.2 / 회벽 위 먹 13.9, 단풍 6.6 / 단풍 위 흰 글자 7.2
   */
  :root {
    --ground: #e6e7e6; /* 기와 회색: 전체 바탕 */
    --wall: #f5f5f4; /* 흰 회벽: 정보 면, 탭바 */
    --wall-glass: #f5f5f4eb; /* 사진 위에 놓이는 회벽 면 */
    --ink: #23262b; /* 먹: 본문 */
    --ink-soft: #4a4f57; /* 젖은 기와: 보조문 */
    --maple: #9f2f25; /* 늦가을 단풍: 지금, 예약, 주요 버튼 */
    --maple-press: #842519;
    --beam: #5a3a22; /* 들보: 시간축, 막새 띠, 선택 표시 */
    --pebble: #c5c7c9; /* 비활성 점 */
    --stone: #d3d5d7; /* 보조 버튼: 회벽 위에서도, 바탕 위에서도 보이는 돌색 */

    --serif: 'Kyoto Trip Serif', 'AppleMyungjo', 'Nanum Myeongjo', serif;
    --sans:
      'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo',
      'Noto Sans KR', 'Hiragino Sans', 'Noto Sans JP', sans-serif;

    /* 루트 글자 크기 = 18px. rem은 18px 기준 */
    --text-body: 1rem; /* 18px: 본문 최소 */
    --text-small: 0.889rem; /* 16px: 보조문 최소 */
    --text-h2: 1.45rem; /* 26px */
    --text-h1: 2.3rem; /* 41px */

    --gutter: 20px;
    --tabbar-h: 76px;
    --eaves-h: 12px;
    --backdrop-h: 560px;
    --tap: 48px;
    color-scheme: light;

  }

  * {
    box-sizing: border-box;
  }
  html {
    font-size: 18px;
    -webkit-text-size-adjust: 100%;
  }
  body {
    position: relative;
    margin: 0;
    color: var(--ink);
    background: var(--ground);
    font-family: var(--sans);
    font-size: var(--text-body);
    line-height: 1.65;
    word-break: keep-all;
    overflow-wrap: anywhere;
    -webkit-tap-highlight-color: transparent;
  }
  main {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
    padding: 24px var(--gutter) calc(var(--tabbar-h) + var(--eaves-h) + 48px + env(safe-area-inset-bottom));
  }
  body.bleed main {
    padding-top: 0;
  }

  /* 단풍 사진 배경: 위쪽에 깔리고 아래로 기와 회색에 스며든다 */
  .backdrop {
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--backdrop-h);
    background: var(--backdrop) center / cover no-repeat;
    pointer-events: none;
  }
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      /* 위쪽: 사진 위 흰 제목이 밝은 하늘에서도 읽히도록 옅게 어둡힌다 */
      linear-gradient(180deg, #1a120c80 0%, #1a120c40 22%, #1a120c00 42%),
      /* 아래쪽: 기와 회색 바탕으로 스며든다 */
      linear-gradient(180deg, #e6e7e600 0%, #e6e7e655 30%, #e6e7e6d9 72%, var(--ground) 96%);
  }

  /* 기와 막새 띠: 화면 맨 위, 탭바 위 두 곳에만 */
  .eaves {
    height: var(--eaves-h);
    background: radial-gradient(circle at 10px 0, var(--beam) 9px, transparent 9.5px) 0 0 / 20px
      var(--eaves-h) repeat-x;
  }
  body > .eaves {
    position: relative;
    z-index: 1;
  }

  h1,
  h2,
  h3,
  .serif {
    font-family: var(--serif);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  h1 {
    font-size: var(--text-h1);
    line-height: 1.15;
    margin: 12px 0 8px;
  }
  h2 {
    font-size: var(--text-h2);
    line-height: 1.25;
    margin: 48px 0 16px;
  }
  h3 {
    font-size: 1.15rem;
    line-height: 1.3;
  }
  /* 사진 위에 놓이는 제목과 글 */
  .on-photo {
    color: #fff;
    text-shadow: 0 2px 16px #0009;
  }
  a {
    color: var(--maple);
  }
  img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  .muted {
    color: var(--ink-soft);
  }

  /* 회벽 면: 카드 대신 쓰는 정보 면 (모서리 없음, 그림자 없음) */
  .wall {
    background: var(--wall);
    padding: 18px 20px;
  }
  .wall.on-backdrop {
    background: var(--wall-glass);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: var(--tap);
    padding: 0 20px;
    border: 0;
    border-radius: 0;
    background: var(--stone);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.12s ease,
      background-color 0.15s ease;
  }
  .btn.primary {
    background: var(--maple);
    color: #fff;
  }
  .btn.primary:active {
    background: var(--maple-press);
  }
  .btn:active {
    transform: scale(0.97);
  }
  :focus-visible {
    outline: 3px solid var(--maple);
    outline-offset: 2px;
  }

  /* 예약 등 상태 표시: 단풍색 굵은 글자 */
  .tag {
    font-size: var(--text-small);
    font-weight: 800;
    color: var(--maple);
    white-space: nowrap;
  }


  .back {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--ground);
    padding: env(safe-area-inset-top) 8px 0;
  }
  .back.floating {
    position: fixed;
    inset: var(--eaves-h) auto auto 0;
    background: none;
    padding: calc(8px + env(safe-area-inset-top)) 12px 0;
  }
  .back a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: var(--tap);
    padding: 0 16px 0 10px;
    font-weight: 700;
    text-decoration: none;
    color: var(--ink);
  }
  .back.floating a {
    background: var(--wall-glass);
  }
  .back svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tabbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 10;
    background: var(--wall);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .tabbar .eaves {
    background-color: var(--ground);
  }
  .tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .tabs a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    height: var(--tabbar-h);
    color: var(--ink-soft);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 700;
  }
  .tabs svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tabs a[aria-current='page'] {
    color: var(--maple);
  }
  .tabs a[aria-current='page'] svg {
    stroke-width: 2.2;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
