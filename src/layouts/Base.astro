---
import { pwaInfo } from 'virtual:pwa-info';

export type Tab = 'itinerary' | 'landmarks' | 'basics';

interface Props {
  title: string;
  tab: Tab;
  /** 상세 화면이면 상단에 돌아가기 링크를 둔다 */
  back?: { href: string; label: string };
}

const { title, tab, back } = Astro.props;
const pageTitle = title === '교토여행' ? title : `${title} · 교토여행`;

const tabs: { id: Tab; href: string; label: string; icon: string }[] = [
  {
    id: 'itinerary',
    href: '/',
    label: '일정',
    icon: '<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  },
  {
    id: 'landmarks',
    href: '/landmarks/',
    label: '교토 명소',
    icon: '<path d="M3 7c3 1 15 1 18 0l-.5 2.5c-4 .8-13 .8-17 0z"/><path d="M5 11h14M7.5 9v12M16.5 9v12"/>',
  },
  {
    id: 'basics',
    href: '/basics/',
    label: '일본 기본',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/>',
  },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#d6302b" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="교토여행" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    {
      back && (
        <nav class="back">
          <a href={back.href}>‹ {back.label}</a>
        </nav>
      )
    }
    <main>
      <slot />
    </main>
    <nav class="tabbar" aria-label="메인 메뉴">
      {
        tabs.map((t) => (
          <a href={t.href} aria-current={t.id === tab ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} />
            <span>{t.label}</span>
          </a>
        ))
      }
    </nav>
    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fff8f0;
    --surface: #ffffff;
    --text: #1f1b18;
    --muted: #6b625a;
    --line: #eadfd3;
    --accent: #d6302b;
    --accent-soft: #fde8e4;
    --ok: #1e6b3a;
    --ok-soft: #e2f3e7;
    --radius: 16px;
    --tabbar-h: 68px;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #17130f;
      --surface: #231e19;
      --text: #f4ede6;
      --muted: #b3a89c;
      --line: #3a322a;
      --accent: #ff6b5e;
      --accent-soft: #3d1f1b;
      --ok: #7fd49a;
      --ok-soft: #1c3324;
    }
  }
  * {
    box-sizing: border-box;
  }
  html {
    font-size: 18px;
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family:
      -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Noto Sans KR', 'Hiragino Sans',
      'Noto Sans JP', sans-serif;
    line-height: 1.65;
    word-break: keep-all;
    overflow-wrap: anywhere;
    -webkit-tap-highlight-color: transparent;
  }
  main {
    max-width: 640px;
    margin: 0 auto;
    padding: 16px 16px calc(var(--tabbar-h) + 32px + env(safe-area-inset-bottom));
  }
  h1 {
    font-size: 1.6rem;
    line-height: 1.3;
    margin: 8px 0 4px;
  }
  h2 {
    font-size: 1.25rem;
    line-height: 1.35;
    margin: 32px 0 12px;
  }
  a {
    color: var(--accent);
  }
  img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  .muted {
    color: var(--muted);
  }
  .lead {
    color: var(--muted);
    margin: 0 0 8px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1.5px solid var(--accent);
    background: var(--surface);
    color: var(--accent);
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }
  .btn.primary {
    background: var(--accent);
    color: #fff;
  }
  .badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    white-space: nowrap;
  }
  .back {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    padding: calc(4px + env(safe-area-inset-top)) 8px 4px;
  }
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 8px;
    font-weight: 700;
    text-decoration: none;
  }
  .tabbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 10;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--surface);
    border-top: 1px solid var(--line);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .tabbar a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    height: var(--tabbar-h);
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .tabbar svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tabbar a[aria-current='page'] {
    color: var(--accent);
  }
</style>
