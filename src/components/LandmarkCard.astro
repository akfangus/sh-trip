---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  landmark: CollectionEntry<'landmarks'>;
  day?: number;
}

const { landmark, day } = Astro.props;
const { nameKo, nameJa, summary, image } = landmark.data;
---

<a class="lm card" href={`/landmarks/${landmark.id}/`}>
  <Image src={image} alt="" width={240} quality={60} class="thumb" />
  <span class="text">
    {day && <span class="badge">Day {day}</span>}
    <strong>{nameKo}</strong>
    <span class="ja muted" lang="ja">{nameJa}</span>
    <span class="summary">{summary}</span>
  </span>
</a>

<style>
  .lm {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 14px;
    align-items: start;
    padding: 12px;
    color: inherit;
    text-decoration: none;
    margin-bottom: 12px;
  }
  .thumb {
    width: 104px;
    height: 104px;
    object-fit: cover;
    border-radius: 12px;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    line-height: 1.4;
  }
  strong {
    font-size: 1.1rem;
  }
  .ja {
    font-size: 0.85rem;
  }
  .summary {
    font-size: 0.95rem;
    margin-top: 4px;
  }
</style>
