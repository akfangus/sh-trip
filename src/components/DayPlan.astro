---
import type { CollectionEntry } from 'astro:content';
import { PERIOD_LABEL, type Period } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  day: CollectionEntry<'itinerary'>;
  /** 홈처럼 짧게 보여줄 때: 설명 한 줄만 남기고 메모와 버튼은 뺀다 */
  compact?: boolean;
  /** 명소 줄 전체를 눌러 "지금 구경하는 곳"으로 고를 수 있게 한다 (홈) */
  pickable?: boolean;
}

const { day, compact = false, pickable = false } = Astro.props;
const periods = (Object.keys(PERIOD_LABEL) as Period[])
  .map((period) => ({ period, items: day.data.items.filter((i) => i.period === period) }))
  .filter((p) => p.items.length > 0);
---

<div class:list={['plan', { compact }]} data-plan-day={day.data.day}>
  {
    periods.map(({ period, items }) => (
      <section class="period" data-period={period}>
        <h3>
          {PERIOD_LABEL[period]}
          <span class="now-label" hidden>
            지금
          </span>
        </h3>
        <ul class="items">
          {items.map((item) => (
            <li class:list={['item', item.status, item.kind, { pick: pickable && item.landmark }]}>
              {pickable && item.landmark && (
                <button
                  class="pick-btn"
                  type="button"
                  data-pick={item.landmark.id}
                  aria-pressed="false"
                  aria-label={`${item.title}, 지금 구경하는 곳으로 고르기`}
                />
              )}
              <Icon name={item.kind} class="kind" />
              <div class="body">
                <p class="title">
                  {item.time && <span class="time">{item.time}</span>}
                  {item.title}
                  {item.status === 'reserved' && <span class="tag">예약</span>}
                  {pickable && item.landmark && <span class="here-tag">지금 여기</span>}
                </p>
                {item.detail && <p class="detail">{item.detail}</p>}
                {!compact && item.note && <p class="note">{item.note}</p>}
                {!compact && (item.landmark || item.mapsUrl) && (
                  <div class="actions">
                    {item.landmark && (
                      <a class="btn primary" href={`/landmarks/${item.landmark.id}/`}>
                        해설 읽기
                      </a>
                    )}
                    {item.mapsUrl && (
                      <a class="btn" href={item.mapsUrl} target="_blank" rel="noopener">
                        구글맵
                      </a>
                    )}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<script>
  import { periodOf, tripDayOf } from '../lib/tripDay';
  import { currentTime } from '../lib/now';

  // 여행 중이면 오늘의 "지금" 시간대 들보를 단풍색으로 칠한다 (일본 시간 기준).
  const today = tripDayOf(currentTime());
  if (today.kind === 'day') {
    const now = periodOf(currentTime());
    document
      .querySelectorAll<HTMLElement>(`[data-plan-day="${today.day}"] [data-period="${now}"]`)
      .forEach((section) => {
        section.classList.add('is-now');
        section.querySelector<HTMLElement>('.now-label')?.removeAttribute('hidden');
      });
  }
</script>

<style>
  .period {
    display: grid;
    grid-template-columns: 3.2em 1fr;
    column-gap: 14px;
    margin-top: 22px;
  }
  .period:first-child {
    margin-top: 0;
  }
  h3 {
    margin: 4px 0 0;
    font-size: 1.1rem;
    color: var(--beam);
  }
  .now-label[hidden] {
    display: none;
  }
  .now-label {
    display: block;
    margin-top: 2px;
    font-family: var(--sans);
    font-size: var(--text-small);
    font-weight: 800;
    color: var(--maple);
  }
  /* 지금 시간대: 들보가 단풍색이 된다. 화면에서 강조색이 데이터에 쓰이는 유일한 자리 */
  .period.is-now h3 {
    color: var(--maple);
  }
  .period.is-now .items {
    border-left-color: var(--maple);
  }
  /* 들보: 시간대마다 굵은 갈색 세로 막대 */
  .items {
    list-style: none;
    margin: 0;
    padding: 0 0 0 14px;
    border-left: 8px solid var(--beam);
  }
  .item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 0;
  }
  .item :global(.kind) {
    margin-top: 2px;
    color: var(--beam);
  }
  /* 고를 수 있는 명소 줄: 줄 전체가 버튼 (투명 버튼을 줄 위에 깐다) */
  .item.pick {
    position: relative;
    margin-left: -14px;
    padding: 12px 14px;
    background: #fff;
    border: 1px solid #e2e2e0;
    border-left: 0;
  }
  .item.pick + .item.pick {
    margin-top: 6px;
  }
  .pick-btn {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .pick-btn:focus-visible {
    outline-offset: -3px;
  }
  .here-tag {
    display: none;
    margin-left: 6px;
    font-size: var(--text-small);
    font-weight: 800;
    color: var(--maple);
  }
  .item.pick:has(.pick-btn[aria-pressed='true']) {
    background: var(--wall);
    border-left: 4px solid var(--maple);
    padding-left: 10px;
  }
  .item.pick:has(.pick-btn[aria-pressed='true']) .here-tag {
    display: inline;
  }
  .item.pick:has(.pick-btn[aria-pressed='true']) :global(.kind) {
    color: var(--maple);
  }
  .item.reserved {
    background: var(--wall);
    margin-left: -14px;
    padding: 12px 14px;
  }
  .item.reserved :global(.kind) {
    color: var(--maple);
  }
  .body {
    flex: 1;
    min-width: 0;
  }
  .title {
    margin: 0;
    font-weight: 700;
    line-height: 1.4;
  }
  .time {
    font-family: var(--serif);
    margin-right: 6px;
    font-variant-numeric: tabular-nums;
  }
  .reserved .time {
    color: var(--maple);
  }
  .tag {
    margin-left: 6px;
  }
  .detail,
  .note {
    margin: 2px 0 0;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .note {
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
</style>
