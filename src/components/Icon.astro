---
/** 선 아이콘 모음. 색은 currentColor 를 따른다. */
export type IconName = 'place' | 'meal' | 'move' | 'look' | 'plus';

interface Props {
  name: IconName;
  class?: string;
}

const PATHS: Record<IconName, string> = {
  // 도리이: 가는 곳
  place: '<path d="M2.5 6.5c3.5 1.3 15.5 1.3 19 0l-.6 2.6c-4.3.9-13.5.9-17.8 0z"/><path d="M5 12h14M7.5 9v12M16.5 9v12"/>',
  // 그릇: 먹는 것
  meal: '<path d="M3 11h18a9 9 0 0 1-18 0z"/><path d="M8 20h8M12 4v4M9 6l1 2M15 6l-1 2"/>',
  // 열차: 큰 이동
  move: '<rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 10h14M9 21l-2-4M15 21l2-4M9 14h.01M15 14h.01"/>',
  // 눈: 꼭 볼 것
  look: '<circle cx="12" cy="12" r="3"/><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
};

const { name, class: className } = Astro.props;
---

<svg class:list={['icon', className]} viewBox="0 0 24 24" aria-hidden="true" set:html={PATHS[name]} />

<style>
  .icon {
    width: 26px;
    height: 26px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
