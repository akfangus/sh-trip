---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getDays } from '../../lib/content';

const days = await getDays();

/** 일정 상태별 표시 방법: 꼬리표 문구와, 시간 앞에 "약"을 붙일지 */
const STATUS_VIEW = {
  reserved: { tag: '예약 확정', approx: false },
  fixed: { tag: '', approx: false },
  planned: { tag: '', approx: true },
  optional: { tag: '선택', approx: true },
} as const;

const landmarkNames = new Map((await getCollection('landmarks')).map((l) => [l.id, l.data.nameKo]));
---

<Base title="일정" tab="itinerary">
  <h1>일정</h1>
  <p class="lead">시간은 모두 일본 시간이에요. "약"이 붙은 시간은 예상이에요.</p>

  <div class="day-switch" role="tablist" aria-label="날짜 선택">
    {
      days.map((day) => (
        <a
          href={`#day${day.data.day}`}
          role="tab"
          data-day-tab={day.data.day}
          aria-selected={day.data.day === 1 ? 'true' : 'false'}
        >
          <b class="serif">{day.data.day}일째</b>
          <span>{formatDate(day.data.date).replace(/^\d+월 /, '')}</span>
        </a>
      ))
    }
  </div>

  {
    days.map((day) => (
      <section class="day" id={`day${day.data.day}`} data-day={day.data.day} role="tabpanel">
        <header class="day-head">
          <span class="seal">
            <small>DAY</small>
            <b>{day.data.day}</b>
          </span>
          <div>
            <h2>{day.data.title}</h2>
            <p class="muted">{formatDate(day.data.date)}</p>
          </div>
        </header>
        <ol class="timeline">
          {day.data.items.map((item) => (
            <li class:list={['item', item.status]}>
              <div class="time">
                {item.time && (STATUS_VIEW[item.status].approx ? `약 ${item.time}` : item.time)}
              </div>
              <div class="body">
                <div class="title">
                  {item.title}
                  {STATUS_VIEW[item.status].tag && <span class="tag">{STATUS_VIEW[item.status].tag}</span>}
                </div>
                {item.note && <div class="note muted">{item.note}</div>}
                {(item.landmark || item.mapsUrl) && (
                  <div class="actions">
                    {item.landmark && (
                      <a class="btn primary" href={`/landmarks/${item.landmark.id}/`}>
                        {landmarkNames.get(item.landmark.id)} 해설 읽기
                      </a>
                    )}
                    {item.mapsUrl && (
                      <a class="btn" href={item.mapsUrl} target="_blank" rel="noopener">
                        구글맵
                      </a>
                    )}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Base>

<script>
  import { tripDayOf } from '../../lib/tripDay';

  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-day-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-day]')];

  function show(day: number) {
    panels.forEach((p) => (p.hidden = Number(p.dataset.day) !== day));
    tabs.forEach((t) => t.setAttribute('aria-selected', String(Number(t.dataset.dayTab) === day)));
  }

  // 주소의 #dayN > 오늘(일본 날짜) > 첫날 순으로 고른다.
  const fromHash = Number(location.hash.match(/^#day(\d)$/)?.[1]);
  const today = tripDayOf(new Date());
  show(fromHash || (today.kind === 'day' ? today.day : 1));

  tabs.forEach((t) =>
    t.addEventListener('click', (e) => {
      e.preventDefault();
      const day = Number(t.dataset.dayTab);
      show(day);
      history.replaceState(null, '', `#day${day}`);
      window.scrollTo({ top: 0 });
    }),
  );
</script>

<style>
  .day-switch {
    position: sticky;
    top: 0;
    z-index: 4;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 16px calc(-1 * var(--gutter)) 0;
    padding: calc(8px + env(safe-area-inset-top)) var(--gutter) 10px;
    background: color-mix(in srgb, var(--paper) 95%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .day-switch a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    color: var(--ink-soft);
    text-decoration: none;
    line-height: 1.25;
    border-bottom: 3px solid transparent;
  }
  .day-switch b {
    font-size: 1.05rem;
  }
  .day-switch span {
    font-size: 0.78rem;
  }
  .day-switch a[aria-selected='true'] {
    color: var(--vermilion);
    border-bottom-color: var(--vermilion);
  }
  .day {
    padding-top: 24px;
    scroll-margin-top: 90px;
  }
  .day-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }
  .day-head h2 {
    margin: 0;
  }
  .day-head p {
    margin: 0;
  }
  .timeline {
    --time-w: 6.4em;
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* 세로 줄 */
  .timeline::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: calc(var(--time-w) + 10px);
    width: 2px;
    background: var(--rule);
  }
  .item {
    position: relative;
    display: grid;
    grid-template-columns: var(--time-w) 1fr;
    column-gap: 22px;
    padding: 10px 0 18px;
  }
  /* 줄 위의 점 */
  .item::before {
    content: '';
    position: absolute;
    left: calc(var(--time-w) + 5px);
    top: 17px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--ink-soft);
  }
  .item.reserved::before {
    background: var(--vermilion);
    border-color: var(--vermilion);
    box-shadow: 0 0 0 4px #c2381f26;
  }
  .item.fixed::before {
    background: var(--indigo);
    border-color: var(--indigo);
  }
  .time {
    font-size: 0.78rem;
    line-height: 1.5;
    padding-top: 4px;
    text-align: right;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .item.reserved .time,
  .item.fixed .time {
    font-family: var(--serif);
    font-weight: 800;
    font-size: 1rem;
    padding-top: 2px;
    color: var(--ink);
  }
  .item.reserved .time {
    color: var(--vermilion);
  }
  .title {
    font-weight: 700;
  }
  .item.reserved .body {
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--vermilion);
    padding: 10px 14px 12px;
    margin-top: -6px;
  }
  .title .tag {
    margin-left: 6px;
    vertical-align: 2px;
  }
  .item.optional .tag {
    color: var(--ink-soft);
  }
  .note {
    font-size: 0.9rem;
    margin-top: 2px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
</style>
