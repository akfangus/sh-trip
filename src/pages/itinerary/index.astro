---
import { getEntry } from 'astro:content';
import DayPlan from '../../components/DayPlan.astro';
import Base from '../../layouts/Base.astro';
import { formatDateLong, formatDayShort, getDays } from '../../lib/content';

const days = await getDays();
const reservedCount = days.flatMap((d) => d.data.items).filter((i) => i.status === 'reserved').length;
const backdrop = (await getEntry('landmarks', 'philosophers-path'))!.data.image;
---

<Base title="일정" tab="itinerary" backdrop={backdrop}>
  <header class="page-head">
    <h1>일정</h1>
    <p>정해진 시각은 예약 식사 {reservedCount}곳과 비행기, 하루카뿐이에요</p>
  </header>

  <nav class="day-switch" aria-label="날짜 선택">
    {
      days.map((day) => (
        <a
          href={`#day${day.data.day}`}
          data-day-tab={day.data.day}
          aria-current={day.data.day === 1 ? 'true' : undefined}
        >
          <b>{day.data.day}일째</b>
          <span>{formatDayShort(day.data.date)}</span>
        </a>
      ))
    }
  </nav>

  {
    days.map((day) => (
      <section class="day" id={`day${day.data.day}`} data-day={day.data.day}>
        <header class="day-head">
          <h2>{day.data.title}</h2>
          <p class="muted">{formatDateLong(day.data.date)}</p>
        </header>
        <DayPlan day={day} />
      </section>
    ))
  }
</Base>

<script>
  import { tripDayOf } from '../../lib/tripDay';
  import { currentTime } from '../../lib/now';

  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-day-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-day]')];

  function show(day: number) {
    panels.forEach((p) => (p.hidden = Number(p.dataset.day) !== day));
    tabs.forEach((t) =>
      Number(t.dataset.dayTab) === day ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current'),
    );
  }

  // 주소의 #dayN > 오늘(일본 날짜) > 첫날 순으로 고른다.
  const fromHash = Number(location.hash.match(/^#day(\d)$/)?.[1]);
  const today = tripDayOf(currentTime());
  show(fromHash || (today.kind === 'day' ? today.day : 1));

  tabs.forEach((t) =>
    t.addEventListener('click', (e) => {
      e.preventDefault();
      const day = Number(t.dataset.dayTab);
      show(day);
      history.replaceState(null, '', `#day${day}`);
    }),
  );
</script>

<style>
  .day-switch {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 20px;
    border-bottom: 1px solid var(--pebble);
  }
  .day-switch a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    color: var(--ink-soft);
    font-size: var(--text-small);
    line-height: 1.3;
    text-decoration: none;
    border-bottom: 4px solid transparent;
    margin-bottom: -1px;
  }
  .day-switch b {
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--ink);
  }
  .day-switch a[aria-current='true'] {
    border-bottom-color: var(--beam);
  }
  .day-switch a[aria-current='true'] {
    color: var(--ink);
  }
  .day {
    scroll-margin-top: 16px;
  }
  .day-head {
    margin: 26px 0 18px;
  }
  .day-head h2 {
    margin: 0;
  }
  .day-head p {
    margin: 2px 0 0;
  }
</style>
