---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDateLong, getDays, getVisitedLandmarks } from '../../lib/content';

const all = new Map((await getCollection('landmarks')).map((l) => [l.id, l]));
const visited = await getVisitedLandmarks();
const days = await getDays();
const backdrop = (await getEntry('landmarks', 'kinkakuji'))!.data.image;

/** 가는 곳을 처음 방문하는 날별로 묶는다 */
const byDay = days
  .map((day) => ({
    day,
    landmarks: [...visited].filter(([, v]) => v.day === day.data.day).map(([id]) => all.get(id)!),
  }))
  .filter((g) => g.landmarks.length > 0);

const others = [...all.values()]
  .filter((l) => !visited.has(l.id))
  .sort((a, b) => a.data.nameKo.localeCompare(b.data.nameKo, 'ko'));
---

<Base title="교토 명소" tab="landmarks" backdrop={backdrop}>
  <header class="page-head">
    <h1>교토 명소</h1>
    <p>그 자리에서 1~2분이면 읽어요</p>
  </header>
  <p class="intro wall on-backdrop">우리가 가는 곳 {visited.size}곳, 시간이 나면 들를 곳 {others.length}곳</p>

  {
    byDay.map(({ day, landmarks: [head, ...tail] }) => (
      <section>
        <h2>{day.data.day}일째에 가는 곳</h2>
        <p class="sub muted">{formatDateLong(day.data.date)}</p>
        <a class="big" href={`/landmarks/${head.id}/`}>
          <Image src={head.data.image} alt="" width={800} quality={60} />
          <span class="big-text">
            <span class="ja muted" lang="ja">
              {head.data.nameJa}
            </span>
            <strong class="serif">{head.data.nameKo}</strong>
            <span class="muted">{head.data.summary}</span>
          </span>
        </a>
        {tail.map((l) => (
          <a class="row" href={`/landmarks/${l.id}/`}>
            <Image src={l.data.image} alt="" width={240} quality={60} />
            <span>
              <strong class="serif">{l.data.nameKo}</strong>
              <span class="muted">{l.data.summary}</span>
            </span>
          </a>
        ))}
      </section>
    ))
  }

  {
    others.length > 0 && (
      <section>
        <h2>시간이 나면 들를 곳</h2>
        <p class="sub muted">일정에는 없지만 가 볼 만한 곳이에요</p>
        {others.map((l) => (
          <a class="row" href={`/landmarks/${l.id}/`}>
            <Image src={l.data.image} alt="" width={240} quality={60} />
            <span>
              <strong class="serif">{l.data.nameKo}</strong>
              <span class="muted">{l.data.summary}</span>
            </span>
          </a>
        ))}
      </section>
    )
  }
</Base>

<style>
  .intro {
    margin: 18px 0 0;
    font-weight: 700;
  }
  h2 {
    margin: 40px 0 0;
  }
  .sub {
    margin: 2px 0 14px;
    font-size: var(--text-small);
  }
  .big,
  .row {
    color: var(--ink);
    text-decoration: none;
  }
  .big {
    display: block;
  }
  .big :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .big-text {
    display: flex;
    flex-direction: column;
    background: var(--wall);
    padding: 14px 16px 16px;
    line-height: 1.45;
  }
  .big .ja {
    font-size: var(--text-small);
  }
  .big strong {
    font-size: 1.45rem;
    line-height: 1.3;
  }
  .row {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 14px;
    align-items: center;
    margin-top: 10px;
    background: var(--wall);
  }
  .row :global(img) {
    width: 112px;
    height: 104px;
    object-fit: cover;
  }
  .row > span {
    display: flex;
    flex-direction: column;
    padding: 8px 12px 8px 0;
    line-height: 1.4;
  }
  .row strong {
    font-size: 1.15rem;
  }
  .row .muted {
    font-size: var(--text-small);
  }
</style>
