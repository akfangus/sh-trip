---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import DayPlan from '../components/DayPlan.astro';
import Base from '../layouts/Base.astro';
import { getDays, getVisitedLandmarks, PERIOD_LABEL } from '../lib/content';

const days = await getDays();
const visited = await getVisitedLandmarks();
const landmarks = new Map((await getCollection('landmarks')).map((l) => [l.id, l]));
const going = [...visited.keys()].map((id) => landmarks.get(id)!);
const backdrop = (await getEntry('landmarks', 'kiyomizudera'))!.data.image;
/** 아래 두 칸(가는 곳, 처음 일본이라면)은 같은 줄 수로 맞춰 바닥선을 맞춘다 */
const LIST_LIMIT = 5;
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order).slice(0, LIST_LIMIT - 1);


---

<Base title="홈" tab="home" backdrop={backdrop}>
  <div class="home">
    <header class="page-head span-12">
      <h1>교토여행</h1>
    </header>

    <section class="panel here span-12" aria-labelledby="here-title">
      <h2 id="here-title">지금 구경하는 곳</h2>
      <p class="here-empty" data-here-empty>아래 일정에서 명소를 누르면 여기에 띄워 둘게요.</p>
      {
        going.map((l) => (
          <div class="here-card" data-here={l.id} hidden>
            <a class="here-link" href={`/landmarks/${l.id}/`}>
              <Image src={l.data.image} alt="" width={240} quality={60} />
              <span class="here-text">
                <strong class="serif">{l.data.nameKo}</strong>
                <span>{l.data.summary}</span>
                <span class="here-go">해설 보기</span>
              </span>
            </a>
            <button class="btn here-clear" type="button" data-here-clear>
              다 봤어요
            </button>
          </div>
        ))
      }
    </section>


    <section class="panel today span-12" aria-labelledby="today-title">
      <header class="panel-head">
        <h2 id="today-title" data-today-title>1일째 일정</h2>
        <a class="more" href="/itinerary/" data-today-link>전체 일정</a>
      </header>
      {
        days.map((day) => (
          <div data-today-day={day.data.day} hidden={day.data.day !== 1}>
            <DayPlan day={day} compact pickable />
          </div>
        ))
      }
    </section>


    <section class="panel span-6" aria-labelledby="going-title">
      <header class="panel-head">
        <h2 id="going-title">우리가 가는 곳</h2>
        <a class="more" href="/landmarks/">모두 {going.length}곳</a>
      </header>
      <ul class="rows">
        {
          going.slice(0, LIST_LIMIT).map((l) => (
            <li>
              <a class="row" href={`/landmarks/${l.id}/`}>
                <Image src={l.data.image} alt="" width={120} quality={60} />
                <span class="row-text">
                  <strong>{l.data.nameKo}</strong>
                  <span>
                    {visited.get(l.id)!.day}일째 {PERIOD_LABEL[visited.get(l.id)!.period]}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="panel span-6" aria-labelledby="basics-title">
      <header class="panel-head">
        <h2 id="basics-title">처음 일본이라면</h2>
        <a class="more" href="/basics/">일본 기본</a>
      </header>
      <ul class="rows">
        <li>
          <a class="row text-row" href="/basics/">
            <span class="row-text">
              <strong>보여주는 일본어</strong>
              <span>누르면 일본어가 화면 가득 나와요</span>
            </span>
          </a>
        </li>
        {
          guides.map((g) => (
            <li>
              <a class="row text-row" href="/basics/">
                <span class="row-text">
                  <strong>{g.data.title}</strong>
                  <span>{g.data.summary}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<script>
  import { tripDayOf } from '../lib/tripDay';
  import { currentTime } from '../lib/now';

  const today = tripDayOf(currentTime());
  const $ = (sel: string) => document.querySelector<HTMLElement>(sel)!;

  // 오늘 일정 칸: 여행 중이면 오늘, 여행 전이면 첫날
  const showDay = today.kind === 'day' ? today.day : 1;
  document.querySelectorAll<HTMLElement>('[data-today-day]').forEach((el) => {
    el.hidden = Number(el.dataset.todayDay) !== showDay;
  });
  $('[data-today-title]').textContent = today.kind === 'day' ? `오늘 일정, ${showDay}일째` : `${showDay}일째 일정`;
  $('[data-today-link]').setAttribute('href', `/itinerary/#day${showDay}`);

  // 지금 구경하는 곳: 일정의 명소 줄을 누르면 이 폰에 저장하고 위 칸에 띄운다
  const KEY = 'kyoto-trip.current-place';
  const load = () => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };
  const save = (id: string | null) => {
    try {
      if (id) localStorage.setItem(KEY, id);
      else localStorage.removeItem(KEY);
    } catch {
      /* 저장할 수 없는 환경이면 이번 화면에서만 보여준다 */
    }
  };
  let current = load();

  function render() {
    let shown = false;
    document.querySelectorAll<HTMLElement>('[data-here]').forEach((card) => {
      card.hidden = card.dataset.here !== current;
      shown ||= !card.hidden;
    });
    $('[data-here-empty]').hidden = shown;
    document.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.pick === current));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) =>
    b.addEventListener('click', () => {
      current = current === b.dataset.pick ? null : (b.dataset.pick ?? null);
      save(current);
      render();
      if (current) $('#here-title').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-here-clear]').forEach((b) =>
    b.addEventListener('click', () => {
      current = null;
      save(null);
      render();
    }),
  );
  render();
</script>

<style>
  /*
   * 격자: 폰은 한 줄, 데스크톱은 12칸 (77px × 12 + 16px × 11 = 1100px).
   * 칸 나눔은 줄마다 바뀌어도 세로선은 위아래로 맞는다: 12 → 6·6
   */
  .home {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 1024px) {
    .home {
      grid-template-columns: repeat(12, 1fr);
      max-width: 1100px;
      margin: 0 auto;
    }
    .span-12 {
      grid-column: span 12;
    }
    .span-6 {
      grid-column: span 6;
    }
  }
  :global(main):has(.home) {
    max-width: none;
  }



  /* 지금 구경하는 곳 */
  .here h2 {
    margin: 0 0 12px;
    font-size: 1.25rem;
    scroll-margin-top: 16px;
  }
  .here-empty {
    margin: 0;
    color: var(--ink-soft);
  }
  .here-link {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 14px;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }
  .here-link :global(img) {
    width: 96px;
    height: 96px;
    object-fit: cover;
  }
  .here-text {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
  }
  .here-text strong {
    font-size: 1.45rem;
    line-height: 1.25;
  }
  .here-text span {
    font-size: var(--text-small);
    color: var(--ink-soft);
  }
  .here-text .here-go {
    margin-top: 4px;
    font-weight: 800;
    color: var(--maple);
  }
  .here-clear {
    width: 100%;
    margin-top: 14px;
  }

  /* 패널: 회벽 면 하나에 제목과 내용을 바로 담는다 */
  .panel {
    background: var(--wall);
    padding: 20px;
    align-self: start;
  }
  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }
  .panel-head h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  .more {
    font-weight: 700;
    font-size: var(--text-small);
    white-space: nowrap;
    color: var(--ink);
  }


  /* 줄 카드: 패널보다 한 단계 밝은 면 + 한 단계 진한 테두리 */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 12px;
    align-items: center;
    height: 74px;
    padding: 8px;
    background: #fff;
    border: 1px solid #e2e2e0;
    color: var(--ink);
    text-decoration: none;
  }
  .row.text-row {
    grid-template-columns: 1fr;
    padding: 10px 14px;
    height: 74px;
  }
  .row.text-row .row-text span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row :global(img) {
    width: 56px;
    height: 56px;
    object-fit: cover;
  }
  .row-text {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
    min-width: 0;
  }
  .row-text span {
    font-size: var(--text-small);
    color: var(--ink-soft);
  }
</style>
