---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import DayPlan from '../components/DayPlan.astro';
import Base from '../layouts/Base.astro';
import { formatDateLong, getDays, getVisitedLandmarks, PERIOD_LABEL } from '../lib/content';

const days = await getDays();
const visited = await getVisitedLandmarks();
const landmarks = new Map((await getCollection('landmarks')).map((l) => [l.id, l]));
const [first, ...rest] = [...visited.keys()].map((id) => landmarks.get(id)!);
const backdrop = (await getEntry('landmarks', 'kiyomizudera'))!.data.image;
const firstDate = formatDateLong(days[0].data.date);
const lastDate = formatDateLong(days[days.length - 1].data.date).replace(/^\d+월 /, '');
---

<Base title="홈" tab="home" backdrop={backdrop}>
  <header class="page-head">
    <h1 class="on-photo">교토여행</h1>
    <p class="on-photo">{firstDate}부터 {lastDate}까지</p>
  </header>

  <p class="status wall on-backdrop" aria-live="polite">
    <b class="serif" data-status-big>첫날</b>
    <span data-status-text>일정을 미리 볼까요?</span>
  </p>

  <section class="days" aria-label="날짜별 일정">
    <div class="days-nav">
      <button class="nav" type="button" data-step="-1" aria-label="이전 날">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
      </button>
      <h2 data-day-title>1일째 {formatDateLong(days[0].data.date).replace(/^\d+월 \d+일 /, '')}</h2>
      <button class="nav" type="button" data-step="1" aria-label="다음 날">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
    <div class="dots" aria-hidden="true">
      {days.map((d) => <i data-dot={d.data.day} />)}
    </div>
    <div class="track" data-track>
      {
        days.map((day) => (
          <article
            class="panel"
            data-panel={day.data.day}
            data-title={`${day.data.day}일째 ${formatDateLong(day.data.date).replace(/^\d+월 \d+일 /, '')}`}
          >
            <DayPlan day={day} compact />
            <a class="more" href={`/itinerary/#day${day.data.day}`}>
              {day.data.day}일째 일정 자세히 보기
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <h2 class="section-title">이번 여행에서 가는 곳</h2>
  {
    first && (
      <a class="big" href={`/landmarks/${first.id}/`}>
        <Image src={first.data.image} alt="" width={800} quality={60} />
        <span class="big-text">
          <span class="when">
            {visited.get(first.id)!.day}일째 {PERIOD_LABEL[visited.get(first.id)!.period]}
          </span>
          <strong class="serif">{first.data.nameKo}</strong>
          <span class="muted">{first.data.summary}</span>
        </span>
      </a>
    )
  }
  <div class="grid">
    {
      rest.map((l) => (
        <a class="small" href={`/landmarks/${l.id}/`}>
          <Image src={l.data.image} alt="" width={400} quality={60} />
          <span class="when">
            {visited.get(l.id)!.day}일째 {PERIOD_LABEL[visited.get(l.id)!.period]}
          </span>
          <strong class="serif">{l.data.nameKo}</strong>
        </a>
      ))
    }
  </div>

  <a class="hotel-link wall" href="/basics/#hotel">
    <span>
      <strong>숙소 주소 보여주기</strong>
      <span class="muted">택시 기사님께 일본어 주소를 보여드려요</span>
    </span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
  </a>
</Base>

<script>
  import { tripDayOf } from '../lib/tripDay';

  const COUNT = ['', '하루', '이틀', '사흘', '나흘', '닷새', '엿새', '이레'];
  const today = tripDayOf(new Date());
  const big = document.querySelector<HTMLElement>('[data-status-big]')!;
  const text = document.querySelector<HTMLElement>('[data-status-text]')!;
  if (today.kind === 'before') {
    big.textContent = COUNT[today.daysLeft] ?? `${today.daysLeft}일`;
    text.textContent = '남았어요. 첫날 일정을 미리 볼까요?';
  } else if (today.kind === 'day') {
    big.textContent = `${today.day}일째`;
    text.textContent = '오늘 일정이에요. 옆으로 밀면 다른 날도 보여요.';
  } else {
    big.textContent = '다녀왔어요';
    text.textContent = '즐거운 여행이었어요.';
  }

  // 날짜별 일정: 옆으로 밀어 넘기기 (스크롤 스냅) + 이전/다음 버튼 + 점 표시
  const track = document.querySelector<HTMLElement>('[data-track]')!;
  const panels = [...track.querySelectorAll<HTMLElement>('[data-panel]')];
  const dots = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
  const title = document.querySelector<HTMLElement>('[data-day-title]')!;
  let current = 1;

  function mark(day: number) {
    current = day;
    dots.forEach((d) => d.classList.toggle('on', Number(d.dataset.dot) === day));
    title.textContent = panels[day - 1].dataset.title ?? '';
    // 보이는 날의 높이에 맞춰 트랙 높이를 바꾼다 (짧은 날 아래 빈 공간 방지)
    track.style.height = `${panels[day - 1].offsetHeight}px`;
  }
  function go(day: number, smooth = true) {
    const d = Math.min(Math.max(day, 1), panels.length);
    track.scrollTo({ left: panels[d - 1].offsetLeft - track.offsetLeft, behavior: smooth ? 'smooth' : 'auto' });
    mark(d);
  }

  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && mark(Number((e.target as HTMLElement).dataset.panel))),
    { root: track, threshold: 0.6 },
  );
  panels.forEach((p) => io.observe(p));
  document.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
    b.addEventListener('click', () => go(current + Number(b.dataset.step))),
  );
  go(today.kind === 'day' ? today.day : 1, false);
</script>

<style>
  .page-head {
    padding-top: 150px;
  }
  .page-head h1 {
    margin: 0;
  }
  .page-head p {
    margin: 4px 0 0;
    font-weight: 600;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 20px 0 0;
    font-weight: 700;
    line-height: 1.45;
  }
  .status b {
    flex: none;
    font-size: 2.1rem;
    line-height: 1;
    color: var(--maple);
  }
  .days {
    margin-top: 30px;
  }
  .days-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .days-nav h2 {
    margin: 0;
    font-size: 1.35rem;
    text-align: center;
  }
  .nav {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 0;
    background: var(--wall-glass);
    color: var(--ink);
    cursor: pointer;
  }
  .nav svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin: 10px 0 18px;
  }
  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: var(--pebble);
    transition: width 0.25s ease;
  }
  .dots i.on {
    width: 24px;
    background: var(--beam);
  }
  .track {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    align-items: flex-start;
    transition: height 0.25s ease;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .panel {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  .more {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: 10px;
    font-weight: 700;
  }
  .section-title {
    margin-top: 44px;
  }
  .big,
  .small {
    color: var(--ink);
    text-decoration: none;
  }
  .big {
    display: block;
  }
  .big :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .big-text {
    display: flex;
    flex-direction: column;
    background: var(--wall);
    padding: 14px 16px 16px;
    line-height: 1.45;
  }
  .big strong {
    font-size: 1.45rem;
    line-height: 1.3;
  }
  .when {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--beam);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 12px;
    margin-top: 18px;
  }
  .small {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }
  .small :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-bottom: 8px;
  }
  .small strong {
    font-size: 1.1rem;
  }
  .hotel-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 36px;
    color: var(--ink);
    text-decoration: none;
  }
  .hotel-link > span {
    display: flex;
    flex-direction: column;
  }
  .hotel-link .muted {
    font-size: var(--text-small);
  }
  .hotel-link svg {
    width: 22px;
    height: 22px;
    flex: none;
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
