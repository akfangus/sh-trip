---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import DayPlan from '../components/DayPlan.astro';
import Base from '../layouts/Base.astro';
import { formatDateLong, getDays, getVisitedLandmarks, PERIOD_LABEL } from '../lib/content';

const days = await getDays();
const visited = await getVisitedLandmarks();
const landmarks = new Map((await getCollection('landmarks')).map((l) => [l.id, l]));
const going = [...visited.keys()].map((id) => landmarks.get(id)!);
const backdrop = (await getEntry('landmarks', 'kiyomizudera'))!.data.image;
const [hotel] = await getCollection('lodging');
/** 아래 두 칸(가는 곳, 처음 일본이라면)은 같은 줄 수로 맞춰 바닥선을 맞춘다 */
const LIST_LIMIT = 5;
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order).slice(0, LIST_LIMIT - 1);

const first = days[0];
const last = days[days.length - 1];
const tripRange = `${formatDateLong(first.data.date)}부터 ${formatDateLong(last.data.date).replace(/^\d+월 /, '')}까지`;

/** 화면에서 "다음 일정", "오늘 가는 곳"을 계산할 때 쓰는 일정 요약 (브라우저에서 오늘 날짜로 고른다) */
const plan = days.map((d) => ({
  day: d.data.day,
  timed: d.data.items.filter((i) => i.time).map((i) => ({ time: i.time!, title: i.title.replace(/ \(.*\)$/, '') })),
  places: new Set(d.data.items.flatMap((i) => (i.landmark ? [i.landmark.id] : []))).size,
}));
const firstTimed = plan[0].timed[0];

---

<Base title="홈" tab="home" backdrop={backdrop}>
  <div class="home">
    <header class="page-head span-12">
      <h1>우리 가족 교토여행</h1>
      <p class="fact" data-fact>{tripRange}, 3박 4일이에요. 첫 일정은 {firstTimed.time} {firstTimed.title}이에요.</p>
    </header>

    <dl class="counts span-12" aria-label="한눈에 보기">
      <div class="count">
        <dt>여행</dt>
        <dd class="value" data-count-trip>D-1</dd>
        <dd class="caption">11월 5일부터 4일</dd>
      </div>
      <div class="count">
        <dt>다음 일정</dt>
        <dd class="value" data-count-next-time>{firstTimed.time}</dd>
        <dd class="caption" data-count-next-title>{firstTimed.title}</dd>
      </div>
      <div class="count">
        <dt>오늘 가는 곳</dt>
        <dd class="value"><span data-count-places>{plan[0].places}</span><span class="unit">곳</span></dd>
        <dd class="caption" data-count-places-caption>도착하는 날은 쉬어요</dd>
      </div>
      <div class="count">
        <dt>숙소 체크인</dt>
        <dd class="value">{hotel.data.checkIn.replace('부터', '')}</dd>
        <dd class="caption">{hotel.data.nameKo.replace('교토 ', '')}</dd>
      </div>
    </dl>

    <section class="panel today span-9" aria-labelledby="today-title">
      <header class="panel-head">
        <h2 id="today-title" data-today-title>1일째 일정</h2>
        <a class="more" href="/itinerary/" data-today-link>전체 일정</a>
      </header>
      {
        days.map((day) => (
          <div data-today-day={day.data.day} hidden={day.data.day !== 1}>
            <DayPlan day={day} compact />
          </div>
        ))
      }
    </section>

    <section class="panel hotel span-3" aria-labelledby="hotel-title">
      <header class="panel-head">
        <h2 id="hotel-title">숙소</h2>
      </header>
      <p class="hotel-ja" lang="ja">{hotel.data.nameJa}</p>
      <p class="hotel-addr" lang="ja">{hotel.data.addressJa.replace(/^〒\S+\s*/, '')}</p>
      <dl class="hotel-times">
        <dt>체크인</dt>
        <dd>{hotel.data.checkIn}</dd>
        <dt>체크아웃</dt>
        <dd>{hotel.data.checkOut}</dd>
      </dl>
      <p class="hotel-access">교토역에서 JR 한 정거장, 우메코지쿄토니시역에서 걸어서 2분. 택시로는 약 10분이에요.</p>
      <a class="btn primary" href="/basics/#hotel">택시 기사님께 보여주기</a>
    </section>

    <section class="panel span-6" aria-labelledby="going-title">
      <header class="panel-head">
        <h2 id="going-title">우리가 가는 곳</h2>
        <a class="more" href="/landmarks/">모두 {going.length}곳</a>
      </header>
      <ul class="rows">
        {
          going.slice(0, LIST_LIMIT).map((l) => (
            <li>
              <a class="row" href={`/landmarks/${l.id}/`}>
                <Image src={l.data.image} alt="" width={120} quality={60} />
                <span class="row-text">
                  <strong>{l.data.nameKo}</strong>
                  <span>
                    {visited.get(l.id)!.day}일째 {PERIOD_LABEL[visited.get(l.id)!.period]}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="panel span-6" aria-labelledby="basics-title">
      <header class="panel-head">
        <h2 id="basics-title">처음 일본이라면</h2>
        <a class="more" href="/basics/">일본 기본</a>
      </header>
      <ul class="rows">
        <li>
          <a class="row text-row" href="/basics/">
            <span class="row-text">
              <strong>보여주는 일본어</strong>
              <span>누르면 일본어가 화면 가득 나와요</span>
            </span>
          </a>
        </li>
        {
          guides.map((g) => (
            <li>
              <a class="row text-row" href="/basics/">
                <span class="row-text">
                  <strong>{g.data.title}</strong>
                  <span>{g.data.summary}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<script is:inline type="application/json" id="plan-data" set:html={JSON.stringify(plan)} />

<script>
  import { periodOf, tripDayOf } from '../lib/tripDay';
  import { currentTime } from '../lib/now';

  type DayPlanData = { day: number; timed: { time: string; title: string }[]; places: number };
  const plan: DayPlanData[] = JSON.parse(document.getElementById('plan-data')!.textContent!);
  const COUNT = ['', '하루', '이틀', '사흘', '나흘', '닷새', '엿새', '이레'];

  const now = currentTime();
  const today = tripDayOf(now);
  const jstHHMM = new Date(now.getTime() + 9 * 3600e3).toISOString().slice(11, 16);
  const $ = (sel: string) => document.querySelector<HTMLElement>(sel)!;

  // 오늘(여행 전이면 첫날)의 다음 시각 일정. 오늘 남은 게 없으면 다음 날 첫 일정.
  const showDay = today.kind === 'day' ? today.day : 1;
  const todays = plan[showDay - 1];
  const next =
    today.kind === 'day'
      ? (todays.timed.find((t) => t.time > jstHHMM) ?? plan.slice(showDay).flatMap((d) => d.timed)[0])
      : todays.timed[0];

  // 제목 아래 한 줄: 오늘의 사실 한 가지
  if (today.kind === 'before') {
    $('[data-fact]').textContent =
      `${COUNT[today.daysLeft] ?? today.daysLeft + '일'} 뒤 출발해요. 첫 일정은 ${todays.timed[0].time} ${todays.timed[0].title}이에요.`;
    $('[data-count-trip]').textContent = `D-${today.daysLeft}`;
  } else if (today.kind === 'day') {
    const period = { morning: '오전', afternoon: '오후', evening: '저녁' }[periodOf(now)];
    $('[data-fact]').textContent = next
      ? `오늘은 ${today.day}일째 ${period}예요. 다음은 ${next.time} ${next.title}이에요.`
      : `오늘은 ${today.day}일째 ${period}예요. 남은 예약 없이 쉬는 시간이에요.`;
    $('[data-count-trip]').textContent = `${today.day}일째`;
  } else {
    $('[data-fact]').textContent = '여행을 마쳤어요. 다들 수고 많으셨어요.';
    $('[data-count-trip]').textContent = '끝';
  }

  // 숫자 칸
  if (next) {
    $('[data-count-next-time]').textContent = next.time;
    $('[data-count-next-title]').textContent = next.title;
  }
  $('[data-count-places]').textContent = String(todays.places);
  $('[data-count-places-caption]').textContent =
    todays.places === 0 ? '도착하는 날은 쉬어요' : `${showDay}일째에 가는 명소`;

  // 오늘 일정 칸
  document.querySelectorAll<HTMLElement>('[data-today-day]').forEach((el) => {
    el.hidden = Number(el.dataset.todayDay) !== showDay;
  });
  $('[data-today-title]').textContent = today.kind === 'day' ? `오늘 일정, ${showDay}일째` : `${showDay}일째 일정`;
  $('[data-today-link]').setAttribute('href', `/itinerary/#day${showDay}`);
</script>

<style>
  /*
   * 격자: 폰은 한 줄, 데스크톱은 12칸 (77px × 12 + 16px × 11 = 1100px).
   * 칸 나눔은 줄마다 바뀌어도 세로선은 위아래로 맞는다: 3·3·3·3 → 9·3 → 6·6
   */
  .home {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 1024px) {
    .home {
      grid-template-columns: repeat(12, 1fr);
      max-width: 1100px;
      margin: 0 auto;
    }
    .span-12 {
      grid-column: span 12;
    }
    .span-9 {
      grid-column: span 9;
    }
    .span-6 {
      grid-column: span 6;
    }
    .span-3 {
      grid-column: span 3;
    }
  }
  :global(main):has(.home) {
    max-width: none;
  }

  .fact {
    font-size: 1.1rem;
    max-width: 38em;
  }

  /* 숫자 칸: 폰 2×2, 데스크톱 4칸. 숫자는 보통 굵기 */
  .counts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 8px 0 0;
  }
  @media (min-width: 1024px) {
    .counts {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .count {
    background: var(--wall);
    padding: 14px 16px 16px;
    min-height: 120px;
  }
  .count dt {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--ink-soft);
  }
  .count dd {
    margin: 0;
  }
  .value {
    font-size: 1.75rem;
    line-height: 1.25;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    margin-top: 2px !important;
  }
  .unit {
    font-size: var(--text-small);
    color: var(--ink-soft);
    margin-left: 2px;
  }
  .caption {
    font-size: var(--text-small);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  /* 패널: 회벽 면 하나에 제목과 내용을 바로 담는다 */
  .panel {
    background: var(--wall);
    padding: 20px;
    align-self: start;
  }
  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }
  .panel-head h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  .more {
    font-weight: 700;
    font-size: var(--text-small);
    white-space: nowrap;
    color: var(--ink);
  }
  @media (min-width: 1024px) {
    .today,
    .hotel {
      align-self: stretch;
    }
  }

  .hotel-ja {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .hotel-addr {
    margin: 4px 0 16px;
    color: var(--ink-soft);
    font-size: var(--text-small);
  }
  .hotel {
    display: flex;
    flex-direction: column;
  }
  .hotel-times {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 12px;
    margin: 0 0 12px;
    font-size: var(--text-small);
  }
  .hotel-times dt {
    color: var(--ink-soft);
    font-weight: 700;
  }
  .hotel-times dd {
    margin: 0;
  }
  .hotel-access {
    margin: 0 0 16px;
    font-size: var(--text-small);
    color: var(--ink-soft);
  }
  /* 늘어난 칸에서는 동작 버튼만 맨 아래에 붙인다 */
  .hotel .btn {
    width: 100%;
    margin-top: auto;
  }

  /* 줄 카드: 패널보다 한 단계 밝은 면 + 한 단계 진한 테두리 */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 12px;
    align-items: center;
    height: 74px;
    padding: 8px;
    background: #fff;
    border: 1px solid #e2e2e0;
    color: var(--ink);
    text-decoration: none;
  }
  .row.text-row {
    grid-template-columns: 1fr;
    padding: 10px 14px;
    height: 74px;
  }
  .row.text-row .row-text span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row :global(img) {
    width: 56px;
    height: 56px;
    object-fit: cover;
  }
  .row-text {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
    min-width: 0;
  }
  .row-text span {
    font-size: var(--text-small);
    color: var(--ink-soft);
  }
</style>
