---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, getDays, getVisitedLandmarks } from '../lib/content';

const days = await getDays();
const visited = await getVisitedLandmarks();
const landmarks = new Map((await getCollection('landmarks')).map((l) => [l.id, l]));
const going = [...visited.keys()].map((id) => landmarks.get(id)!);
const heroImage = (await getEntry('landmarks', 'fushimi-inari'))!.data.image;

/** 홈의 "오늘" 요약에 올릴 항목: 예약 식사와 명소 방문, 정시 일정(항공편) */
const keyItems = (day: (typeof days)[number]) =>
  day.data.items.filter((i) => i.status === 'reserved' || i.status === 'fixed' || i.landmark);

const shortcuts = [
  { href: '/itinerary/', title: '전체 일정', desc: 'Day 1~4 시간표', icon: '<rect x="4" y="5" width="16" height="15" rx="1.5"/><path d="M4 10h16M9 3v4M15 3v4"/>' },
  { href: '/landmarks/', title: '교토 명소', desc: '현장에서 읽는 해설', icon: '<path d="M2.5 6.5c3.5 1.3 15.5 1.3 19 0l-.6 2.6c-4.3.9-13.5.9-17.8 0z"/><path d="M5 12h14M7.5 9v12M16.5 9v12"/>' },
  { href: '/basics/', title: '보여주는 일본어', desc: '눌러서 크게 보여주기', icon: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/>' },
  { href: '/basics/#hotel', title: '숙소 주소', desc: '택시 기사에게 보여주기', icon: '<path d="M3 21V8l9-5 9 5v13"/><path d="M9 21v-6h6v6"/>' },
];
---

<Base title="홈" tab="home" bleed>
  <header class="hero">
    <Image src={heroImage} alt="" width={900} quality={60} class="hero-img" loading="eager" />
    <div class="hero-text">
      <p class="hero-kicker serif">京都 · 우리 가족 가을 여행</p>
      <h1>교토여행</h1>
      <p class="hero-dates">{formatDate(days[0].data.date)} — {formatDate(days[days.length - 1].data.date)}</p>
      <p class="hero-status serif" data-status></p>
    </div>
  </header>

  {
    days.map((day) => (
      <section class="today" data-today-day={day.data.day} hidden={day.data.day !== 1}>
        <div class="section-head">
          <h2 data-today-title>
            Day {day.data.day} · {day.data.title}
          </h2>
          <a class="more" href={`/itinerary/#day${day.data.day}`}>
            전체 보기 ›
          </a>
        </div>
        <ol class="key-items">
          {keyItems(day).map((item) => {
            const lm = item.landmark && landmarks.get(item.landmark.id);
            return (
              <li class:list={[item.status]}>
                <span class="time">{item.time?.split('~')[0]}</span>
                <span class="what">
                  {lm ? (
                    <a href={`/landmarks/${lm.id}/`}>{item.title}</a>
                  ) : (
                    item.title
                  )}
                  {item.status === 'reserved' && <span class="tag">예약</span>}
                </span>
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }

  <div class="section-head">
    <h2>우리가 가는 곳</h2>
    <a class="more" href="/landmarks/">모두 보기 ›</a>
  </div>
  <div class="rail" role="list">
    {
      going.map((l) => (
        <a class="rail-card" href={`/landmarks/${l.id}/`} role="listitem">
          <Image src={l.data.image} alt="" width={440} quality={60} />
          <span class="rail-day">Day {visited.get(l.id)}</span>
          <span class="rail-name serif">{l.data.nameKo}</span>
        </a>
      ))
    }
  </div>

  <div class="section-head">
    <h2>바로가기</h2>
  </div>
  <div class="shortcuts">
    {
      shortcuts.map((s) => (
        <a href={s.href} class="shortcut">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.icon} />
          <strong class="serif">{s.title}</strong>
          <span class="muted">{s.desc}</span>
        </a>
      ))
    }
  </div>
</Base>

<script>
  import { tripDayOf } from '../lib/tripDay';

  const today = tripDayOf(new Date());
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  status.textContent =
    today.kind === 'before'
      ? `출발까지 D-${today.daysLeft}`
      : today.kind === 'day'
        ? `오늘은 여행 ${today.day}일째`
        : '즐거운 여행이었어요';

  // 여행 전에는 첫날, 여행 중에는 오늘, 여행 후에는 요약을 숨긴다.
  const showDay = today.kind === 'day' ? today.day : today.kind === 'before' ? 1 : null;
  document.querySelectorAll<HTMLElement>('[data-today-day]').forEach((el) => {
    el.hidden = Number(el.dataset.todayDay) !== showDay;
    if (!el.hidden && today.kind === 'day') {
      const title = el.querySelector('[data-today-title]');
      if (title) title.textContent = `오늘 · ${title.textContent?.split('·').slice(1).join('·').trim()}`;
    }
  });
</script>

<style>
  .hero {
    position: relative;
    margin: 0 calc(-1 * var(--gutter));
    min-height: 62vh;
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
  }
  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #0000 30%, #1b0f0acc 100%);
  }
  .hero-text {
    position: relative;
    z-index: 1;
    padding: 0 var(--gutter) 28px;
  }
  .hero-kicker {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0.9;
    letter-spacing: 0.04em;
  }
  .hero h1 {
    font-size: 2.8rem;
    margin: 2px 0 4px;
    letter-spacing: 0.02em;
  }
  .hero-dates {
    margin: 0;
    font-weight: 600;
    opacity: 0.95;
  }
  .hero-status {
    display: inline-block;
    margin: 14px 0 0;
    padding: 4px 14px;
    background: var(--vermilion);
    font-size: 1.05rem;
    border-radius: 2px;
  }
  .hero-status:empty {
    display: none;
  }
  .key-items {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .key-items li {
    display: grid;
    grid-template-columns: 4.2em 1fr;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .key-items .time {
    font-family: var(--serif);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }
  .key-items .reserved .time {
    color: var(--vermilion);
  }
  .key-items .what {
    font-weight: 700;
  }
  .key-items a {
    color: var(--ink);
    text-decoration-color: var(--vermilion);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .key-items .tag {
    margin-left: 8px;
    vertical-align: 2px;
  }
  .rail {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    margin: 0 calc(-1 * var(--gutter));
    padding: 0 var(--gutter) 6px;
    scrollbar-width: none;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  .rail-card {
    position: relative;
    flex: none;
    width: 62%;
    max-width: 240px;
    aspect-ratio: 3 / 4;
    scroll-snap-align: start;
    border-radius: 4px;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
  }
  .rail-card :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rail-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #0000 45%, #120a06d9 100%);
  }
  .rail-day,
  .rail-name {
    position: absolute;
    z-index: 1;
    left: 14px;
  }
  .rail-day {
    top: 12px;
    padding: 0 8px;
    font-size: 0.8rem;
    font-weight: 800;
    background: var(--vermilion);
    border-radius: 2px;
  }
  .rail-name {
    bottom: 14px;
    right: 14px;
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .shortcuts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .shortcut {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 128px;
    padding: 16px;
    background: var(--sheet);
    color: var(--ink);
    text-decoration: none;
  }
  .shortcut svg {
    width: 30px;
    height: 30px;
    margin-bottom: 8px;
    fill: none;
    stroke: var(--vermilion);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .shortcut strong {
    font-size: 1.08rem;
  }
  .shortcut span {
    font-size: 0.85rem;
    line-height: 1.4;
  }
</style>
